{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all docker image bumps so we get one PR per week",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker images"
    },
    {
      "description": "Pin OpenWebUI manually — breaking changes ship often",
      "matchPackageNames": ["ghcr.io/open-webui/open-webui"],
      "enabled": false
    }
  ]
}
