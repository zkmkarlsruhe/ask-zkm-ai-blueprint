# cost-tracker/ — environment configuration

# Protected hostname: dashboard + per-user spend API. Must differ from CARBON_DOMAIN.
COST_DOMAIN=costs.example.org
# Public hostname: carbon page + carbon API (the badge calls this one).
CARBON_DOMAIN=carbon.example.org

# DB connections over the shared "ai-bus" network.
# LiteLLM DB: gateway/'s Postgres, alias "litellm-db" on ai-bus.
LITELLM_DB_URL=postgresql://litellm:CHANGE_ME@litellm-db:5432/litellm
# OpenWebUI DB: webui/'s Postgres, alias "<STACK>-db" on ai-bus.
# Read-only DB users are enough for both.
OPENWEBUI_DB_URL=postgresql://openwebui:CHANGE_ME@webui-db:5432/openwebui

# CO2 estimate — kg CO2 per 1k tokens. Default 0.0004 is a rough midpoint of
# published estimates; tune for the model mix you actually run.
CO2_PER_1K_TOKENS=0.0004

# Shadow prices: Postgres regex on api_base for upstreams that send no
# invoice (academic cloud, self-hosted). Spend on those rows is shown as
# "shadow", the rest as "invoiced". Empty = everything counts as invoiced.
# SHADOW_API_BASE_RE=academic-cloud\.example\.eu|ollama|vllm
