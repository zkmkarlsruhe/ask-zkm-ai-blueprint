# cost-tracker/ — environment configuration

# Public hostname for the dashboard + carbon page.
COST_DOMAIN=costs.example.org

# DB connections — these point at the postgres instances in your gateway/ and
# (optionally) webui/ stacks. Use docker-internal hostnames since this app
# runs on the shared "ai-bus" network.
#
# litellm DB lives in gateway/ (postgres service on ai-bus).
LITELLM_DB_URL=postgresql://litellm:CHANGE_ME@postgres:5432/litellm
#
# OpenWebUI DB:
#   - If you stuck with the default sqlite, you can't use this — joins won't
#     work. Run webui/ on postgres first; see ../examples/postgres-vs-sqlite.md
#   - If you switched webui to postgres, point at it here:
OPENWEBUI_DB_URL=postgresql://openwebui:CHANGE_ME@owui-postgres:5432/openwebui

# CO2 estimation — kg CO2 per 1k tokens. Default 0.0004 is a conservative
# midpoint of published estimates; tune for the model mix you actually run.
# This is the number that shows up in the in-chat badge and on /carbon.
CO2_PER_1K_TOKENS=0.0004
