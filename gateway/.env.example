# LiteLLM gateway — environment configuration
#
# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   openssl rand -hex 32

# --- Domain ---
# Where this gateway is reachable from your reverse proxy.
GATEWAY_DOMAIN=llm.zkm.tech

# --- Master key ---
# The admin key for the LiteLLM proxy. Management calls only. Each chat
# instance gets its own virtual key minted with it; never hand this one out.
LITELLM_MASTER_KEY=sk-replace-with-openssl-rand-hex-32

# --- Salt for at-rest secret encryption (provider keys stored in DB) ---
# Back this up next to the DB dump. Lose it and every stored credential is
# unreadable.
LITELLM_SALT_KEY=replace-with-openssl-rand-hex-32

# --- Database (LiteLLM spend logs and virtual keys) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=litellm

# --- Redis (router state: rpm/tpm counters for usage-based routing) ---
REDIS_PASSWORD=replace-with-openssl-rand-hex-24

# --- Provider keys ---
# Add only the ones you actually register in config.yaml. Leave the rest unset.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ACADEMIC_API_KEY_1=
ACADEMIC_API_KEY_2=
EU_PROVIDER_API_KEY=
JINA_API_KEY=
