# document-preprocessor/ — environment

# Reject anything bigger than this before it is read into RAM.
MAX_FILE_SIZE_MB=50

# Where the real conversion happens: a document-convert API that returns
# markdown (adapt _call_upstream / _extract_markdown in src/proxy.py to its
# shape). Leave empty to pass through plain-text files only.
UPSTREAM_CONVERT_URL=
# Key for the upstream. Lives only here, never in OpenWebUI.
UPSTREAM_API_KEY=
