# local-bridge/ — environment

# Where your local backend lives. Common choices:
#   - Ollama:   http://ollama:11434/v1
#   - vLLM:     http://vllm:8000/v1
#   - llama.cpp http://llamacpp:8080/v1     (with --api flag)
BACKEND_BASE_URL=http://ollama:11434/v1
BACKEND_API_KEY=

# Shared secret LiteLLM uses to call this proxy.
INCOMING_BEARER=replace-with-shared-secret

# House-wide ceiling. Per-request max_tokens above this gets clamped down.
MAX_TOKENS_CEILING=4096

# Optional: a system prompt prefix injected into every chat. Leave empty
# unless you have a specific compliance reason.
SYSTEM_PROMPT_PREFIX=
