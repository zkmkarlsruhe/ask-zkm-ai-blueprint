# oauth-translator/ — environment

# The upstream that needs OAuth2 client-credentials.
UPSTREAM_BASE_URL=https://academic-cloud.example.eu/v1
UPSTREAM_TOKEN_URL=https://idp.example.eu/oauth2/token
UPSTREAM_CLIENT_ID=your-client-id
UPSTREAM_CLIENT_SECRET=your-client-secret
UPSTREAM_SCOPE=                              # often empty

# A shared secret LiteLLM uses to reach this proxy. Generate with `openssl rand -hex 24`.
INCOMING_BEARER=replace-with-shared-secret
