# OpenWebUI — environment configuration.
# Generate with `./gen-env.sh > .env` or copy this file and edit.

# --- Branding & locale ---
WEBUI_NAME=My Museum AI
WEBUI_URL=https://chat.example.org
WEBUI_DOMAIN=chat.example.org
DEFAULT_LOCALE=en          # or de, fr, es, ...

# --- Auth ---
# Start with the local form for first admin signup, then disable it once OIDC works.
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=true

# --- Gateway wiring ---
# Where the LiteLLM gateway/ is reachable from this container. The virtual key
# is minted in LiteLLM admin UI; do not use the master key here.
LITELLM_API_BASE=https://api.ai.example.org/v1
LITELLM_VIRTUAL_KEY=sk-replace-with-virtual-key-from-litellm-admin

# --- Vector DB / cache secrets ---
QDRANT_API_KEY=replace-with-openssl-rand-hex-24
REDIS_PASSWORD=replace-with-openssl-rand-hex-24

# --- Session encryption (32-byte random) ---
WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32

# --- OIDC (optional, uncomment in docker-compose.yml too) ---
# These OIDC_* names are the blueprint's own; docker-compose.yml maps them to
# OpenWebUI's actual env vars (OAUTH_PROVIDER_NAME, OAUTH_CLIENT_ID,
# OAUTH_CLIENT_SECRET, OPENID_PROVIDER_URL). See docs/auth.md for the full
# OIDC setup including group-claim role mapping.
# OIDC_PROVIDER_NAME=Keycloak
# OIDC_CLIENT_ID=museum-ai
# OIDC_CLIENT_SECRET=replace-with-real-secret
# OIDC_DISCOVERY_URL=https://sso.example.org/realms/main/.well-known/openid-configuration
