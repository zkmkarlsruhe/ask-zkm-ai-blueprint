# Instance-specific values. Copy to .env, generate the secrets fresh.
STACK=workshop
WEBUI_NAME=Workshop AI
WEBUI_URL=https://workshop.chat.zkm.tech
WEBUI_DOMAIN=workshop.chat.zkm.tech
DEFAULT_LOCALE=en

# Workshop instance: local accounts, no SSO.
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=true

# Its own virtual key, scoped to the models this audience may use.
LITELLM_API_BASE=https://llm.zkm.tech/v1
LITELLM_VIRTUAL_KEY=sk-replace-with-workshop-key
RAG_EMBEDDING_MODEL=house/embed

OWUI_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
QDRANT_API_KEY=replace-with-openssl-rand-hex-24
REDIS_PASSWORD=replace-with-openssl-rand-hex-24
WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32
